#!/usr/bin/env bash
# ligo: one command for the LiGo dev stack (docs/CLAUDE_SETUP.md §3, §12).
#
# Two modes, same commands:
#   docker  (default on your own machine) wraps dev/lila-docker/, our trimmed copy of lichess's
#           lila-docker: everything runs in containers, the site is on http://localhost:8080
#   native  (default in Claude Code cloud sessions) runs sbt and pnpm on the host, with only Mongo
#           and Redis in Docker, as proven in unit 0.2: lila on :9663, lila-ws on :9664
# Override with LIGO_MODE=docker|native.
#
# Licence: MIT (LiGo's own code, ADR 0006).

set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
LD="$ROOT/dev/lila-docker"
STATE="$ROOT/.ligo"
LILA="$ROOT/lila"
WS="$ROOT/lila-ws"
RULES="$ROOT/libs/go-rules"

is_cloud() { [[ "${CLAUDE_CODE_REMOTE:-}" == "true" ]]; }
if [[ -n "${LIGO_MODE:-}" ]]; then MODE=$LIGO_MODE
elif is_cloud; then MODE=native
else MODE=docker; fi
[[ "$MODE" == docker || "$MODE" == native ]] || { echo "LIGO_MODE must be docker or native" >&2; exit 2; }

say() { printf '\033[1;34m[ligo]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[ligo] %s\033[0m\n' "$*" >&2; }
die() { printf '\033[1;31m[ligo] %s\033[0m\n' "$*" >&2; exit 1; }
run() { printf '\033[2m$ %s\033[0m\n' "$*"; "$@"; }

usage() {
  cat <<EOF
Usage: dev/ligo <command> [args]        (mode: $MODE)

  up                  Start the stack (first run builds the UI and compiles; takes a while)
  down                Stop the stack (database data is kept)
  db                  Start only Mongo and Redis (idempotent; the SessionStart hook runs it)
  status              Show what is running
  logs [lila|ws|db]   Follow logs
  compile [what]      Compile lila, ws, ui, rules or all (default: all)
  test [what]         Run the unit tests of lila, ws, ui, rules or all (default: all);
                      rules = libs/go-rules, replaying the libs/conformance fixtures
  e2e [-- args]       Smoke-test the running stack (home page + lobby websocket);
                      with args after --, also run lila's Playwright suite with them
  deps                Fetch dependencies (sbt update, frozen pnpm install); native mode only
  verify-mirror       Cross-check Google-mirror downloads against Maven Central (cloud, ADR 0008)
  katago <cmd>        KataGo: install [cpu|opencl], smoke, bench, path (dev/katago.sh)
  doctor              Check this machine's tools (dev/doctor.sh)
  mode                Print the mode (docker or native)

Site: $(site_url)
EOF
}

site_url() { if [[ "$MODE" == docker ]]; then echo "http://localhost:8080"; else echo "http://localhost:9663"; fi; }

# ui/build writes manifest.json last, so a half-finished build doesn't count as built.
ui_built() { [[ -f "$LILA/public/compiled/manifest.json" ]]; }

# --------------------------------------------------------------------------------------------
# docker mode (wraps dev/lila-docker)

dc() { (cd "$LD" && docker compose "$@"); }

docker_env() {
  # Same logic as upstream lila-docker's write_user_id_to_env: files written by containers
  # into lila/ belong to you, except on Docker Desktop, which maps ownership itself.
  if docker info 2>/dev/null | grep -q "Operating System: Docker Desktop"; then
    printf 'USER_ID=0\nGROUP_ID=0\n' > "$LD/.env"
  else
    printf 'USER_ID=%s\nGROUP_ID=%s\n' "$(id -u)" "$(id -g)" > "$LD/.env"
  fi
  mkdir -p "$LD/.pnpm-store"
}

docker_ui() {
  run dc run --rm -w /lila ui pnpm install --frozen-lockfile
  run dc run --rm -w /lila ui ./ui/build --no-install --debug
}

docker_up() {
  docker_env
  run dc build
  run dc --profile utils build ui
  ui_built || docker_ui
  run dc up -d
  if [[ ! -f "$STATE/docker-db-initialised" ]]; then
    say "waiting for mongodb, then creating lila's indexes (first run only)"
    until dc exec -T mongodb mongosh --quiet --eval 'db.runCommand({ping: 1})' >/dev/null 2>&1; do sleep 2; done
    until dc exec -T mongodb mongosh --quiet --eval 'rs.isMaster().ismaster' 2>/dev/null | grep -q true; do sleep 2; done
    run dc exec -T mongodb mongosh --quiet lichess /lila/bin/mongodb/indexes.js
    run dc exec -T mongodb mongosh --quiet lichess /lila/bin/mongodb/create-trophy-kinds.js
    mkdir -p "$STATE" && touch "$STATE/docker-db-initialised"
  fi
  say "lila compiles on first start (several minutes). Follow it with: dev/ligo logs lila"
  say "then open $(site_url)"
}

docker_sbt() {  # docker_sbt <service> <sbt args...>
  local svc=$1; shift
  if [[ -n "$(dc ps -q "$svc" 2>/dev/null)" ]]; then run dc exec -T "$svc" sbt "$@"
  else run dc run --rm --no-deps --entrypoint sbt "$svc" "$@"; fi
}

# libs/go-rules is its own sbt build; in docker mode it runs in the lila container with libs/
# mounted next to it, so its tests find ../conformance/fixtures.
docker_rules_sbt() { run dc run --rm --no-deps -v "$ROOT/libs:/libs" -w /libs/go-rules --entrypoint sbt lila "$@"; }

# --------------------------------------------------------------------------------------------
# native mode (host sbt + pnpm; Mongo and Redis in Docker)

sbt1() { (cd "$1" && shift && run sbt --server --batch "$@"); }   # one-shot, no background server
lila_sbt() { (cd "$LILA" && run ./lila.sh --server --batch "$@"); }

native_after_sbt() { if is_cloud; then verify_mirror; fi; }

need_node_modules() {
  [[ -d "$LILA/node_modules" && -d "$LILA/ui/.build/node_modules" ]] || die "run dev/ligo deps first"
}

native_ui() { need_node_modules; (cd "$LILA" && CI=1 run ./ui/build --no-install --debug); }

pnpm_install_lila() {
  (cd "$LILA/ui/.build" && run pnpm install --frozen-lockfile)
  if is_cloud; then
    ab_stub_install
  else
    (cd "$LILA" && run pnpm install --frozen-lockfile)
  fi
}

# ADR 0008 step 3. The session's GitHub proxy refuses codeload.github.com tarballs, so build the
# ab-stub tarball from a git clone, check it against the lockfile integrity, point only that
# lockfile URL at the local file for the install, then restore the lockfile.
ab_stub_install() {
  local lock="$LILA/pnpm-lock.yaml" line url sha want tmp tgz got
  line=$(grep -m1 -E 'tarball: https://codeload.github.com/lichess-org/ab-stub/tar.gz/[0-9a-f]{40}' "$lock") \
    || die "ab-stub entry not found in pnpm-lock.yaml"
  url=$(grep -oE 'https://codeload.github.com/lichess-org/ab-stub/tar.gz/[0-9a-f]{40}' <<<"$line" | head -1)
  sha=${url##*/}
  want=$(grep -oE 'integrity: sha512-[A-Za-z0-9+/=]+' <<<"$line" | sed 's/integrity: sha512-//')
  mkdir -p "$STATE/cache"
  tgz="$STATE/cache/ab-stub-$sha.tar.gz"
  if [[ ! -f "$tgz" ]]; then
    tmp=$(mktemp -d)
    run git -C "$tmp" init -q
    run git -C "$tmp" fetch -q --depth 1 https://github.com/lichess-org/ab-stub "$sha"
    git -C "$tmp" archive --format=tar.gz --prefix="ab-stub-$sha/" "$sha" > "$tgz.part"
    rm -rf "$tmp"
    mv "$tgz.part" "$tgz"
  fi
  got=$(openssl dgst -sha512 -binary "$tgz" | base64 -w0)
  [[ "$got" == "$want" ]] || { rm -f "$tgz"; die "ab-stub tarball sha512 mismatch (got $got, want $want)"; }
  say "ab-stub tarball matches the lockfile integrity"
  cp "$lock" "$STATE/cache/pnpm-lock.yaml.orig"
  # Restore the lockfile even if we're interrupted (e.g. the setup script's time limit).
  trap 'cp "$STATE/cache/pnpm-lock.yaml.orig" "$LILA/pnpm-lock.yaml"' EXIT
  trap 'exit 130' INT TERM
  sed -i "s#tarball: $url#tarball: file:$tgz#" "$lock"
  local rc=0
  (cd "$LILA" && run pnpm install --frozen-lockfile) || rc=$?
  cp "$STATE/cache/pnpm-lock.yaml.orig" "$lock"
  trap - EXIT INT TERM
  git -C "$ROOT" diff --quiet -- lila/pnpm-lock.yaml || die "pnpm-lock.yaml was not restored"
  return $rc
}

# ADR 0008 step 2. coursier checks only same-origin checksums, so compare every file fetched from
# Google's mirror with the SHA-1 Maven Central publishes. Verified files are remembered.
verify_mirror() {
  local cache="${COURSIER_CACHE:-$HOME/.cache/coursier/v1}"
  local mirror="$cache/https/maven-central.storage-download.googleapis.com/maven2"
  local db="$STATE/mirror-verified.txt" todo out
  [[ -d "$mirror" ]] || { say "no Google-mirror downloads to verify"; return 0; }
  mkdir -p "$STATE"; touch "$db"
  todo=$(mktemp); out=$(mktemp)
  (cd "$mirror" && find . -type f ! -name '.*' ! -name '*.sha1' ! -name '*.md5' ! -name '*.sha256' \
      ! -name '*.sha512' ! -name '*.asc' ! -name '*.part' ! -name '*.lock' | sed 's#^\./##' | sort) \
    | comm -23 - <(cut -d' ' -f2 "$db" | sort) > "$todo"
  local n; n=$(wc -l < "$todo")
  if (( n == 0 )); then say "mirror cross-check: nothing new ($(wc -l < "$db") files verified before)"; rm -f "$todo" "$out"; return 0; fi
  say "mirror cross-check: comparing $n new files with Maven Central's SHA-1s"
  export MIRROR_DIR="$mirror"
  # shellcheck disable=SC2016 # the script runs in the child bash, so single quotes are intended
  xargs -P 8 -I{} bash -c '
    f={}; local_sha=$(sha1sum "$MIRROR_DIR/$f" | cut -c1-40)
    for i in 1 2 3 4 5 6 7 8; do
      code=$(curl -sS -o /tmp/ligo-sha.$$ -w "%{http_code}" "https://repo1.maven.org/maven2/$f.sha1" 2>/dev/null || echo 000)
      [[ "$code" == 200 ]] && break
      [[ "$code" == 404 ]] && break
      sleep $((i * 2))
    done
    remote=$(grep -oE "[0-9a-f]{40}" /tmp/ligo-sha.$$ 2>/dev/null | head -1); rm -f /tmp/ligo-sha.$$
    if [[ "$code" != 200 || -z "$remote" ]]; then echo "UNVERIFIED $code $f"
    elif [[ "$remote" == "$local_sha" ]]; then echo "OK $local_sha $f"
    else echo "MISMATCH $local_sha!=$remote $f"; fi
  ' < "$todo" > "$out"
  grep '^OK ' "$out" | cut -d' ' -f2- >> "$db" || true
  local ok bad unv
  ok=$(grep -c '^OK ' "$out" || true); bad=$(grep -c '^MISMATCH ' "$out" || true); unv=$(grep -c '^UNVERIFIED ' "$out" || true)
  say "mirror cross-check: $ok matched, $bad mismatched, $unv could not be checked ($(wc -l < "$db") verified in total)"
  if (( bad > 0 || unv > 0 )); then
    grep -v '^OK ' "$out" | head -20 >&2
    rm -f "$todo" "$out"
    die "mirror cross-check failed: do not use these artifacts; tell the owner (ADR 0008)"
  fi
  rm -f "$todo" "$out"
}

port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

native_db_up() {
  local profiles=()
  if port_open 6379 && ! (cd "$LD" && docker compose -f compose.native.yml --profile redis ps -q redis | grep -q .); then
    say "using the redis already listening on 6379"
  else
    profiles=(--profile redis)
  fi
  (cd "$LD" && run docker compose -f compose.native.yml "${profiles[@]}" up -d)
  say "waiting for mongodb"
  until port_open 27017; do sleep 1; done
  if [[ ! -f "$STATE/native-db-initialised" ]]; then
    (cd "$LD" && docker compose -f compose.native.yml exec -T mongodb sh -c 'until mongosh --quiet --eval "db.runCommand({ping:1})" >/dev/null 2>&1; do sleep 1; done')
    (cd "$LD" && docker compose -f compose.native.yml exec -T mongodb mongosh --quiet lichess --eval "$(cat "$LILA/bin/mongodb/indexes.js")") >/dev/null
    (cd "$LD" && docker compose -f compose.native.yml exec -T mongodb mongosh --quiet lichess --eval "$(cat "$LILA/bin/mongodb/create-trophy-kinds.js")") >/dev/null
    mkdir -p "$STATE" && touch "$STATE/native-db-initialised"
    say "created lila's indexes"
  fi
}

start_bg() {  # start_bg <name> <dir> <command...>: survives this shell; stdin kept open for Play
  local name=$1 dir=$2; shift 2
  local pidf="$STATE/$name.pid"
  if [[ -f "$pidf" ]] && kill -0 "$(cat "$pidf")" 2>/dev/null; then say "$name already running"; return; fi
  mkdir -p "$STATE/logs"
  # The child records its own pid: it leads a new session and process group, so stop_bg can
  # signal the whole group (setsid may fork, so $! is not reliable).
  rm -f "$pidf"
  # shellcheck disable=SC2016 # expanded by the child bash
  (cd "$dir" && setsid bash -c 'echo $$ > "$0"; tail -f /dev/null | "$@"' "$pidf" "$@" </dev/null >"$STATE/logs/$name.log" 2>&1 &)
  for _ in $(seq 50); do [[ -s "$pidf" ]] && break; sleep 0.1; done
  say "started $name (log: .ligo/logs/$name.log)"
}

stop_bg() {
  local name=$1 pidf="$STATE/$1.pid" pid
  [[ -f "$pidf" ]] || return 0
  pid=$(cat "$pidf")
  if kill -0 "$pid" 2>/dev/null; then
    kill -TERM -- "-$pid" 2>/dev/null || true
    for _ in $(seq 20); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    kill -KILL -- "-$pid" 2>/dev/null || true
    say "stopped $name"
  fi
  rm -f "$pidf"
}

wait_http() {  # wait_http <url> <seconds>
  local url=$1 limit=$2 t=0
  until [[ "$(curl -s -o /dev/null -w '%{http_code}' "$url" || true)" =~ ^[23] ]]; do
    (( t >= limit )) && return 1
    sleep 5; t=$((t + 5))
  done
}

native_up() {
  need_node_modules
  # A container-created empty application.conf (docker mode's bind mount) would stop lila.sh
  # from copying the default config.
  [[ -f "$LILA/conf/application.conf" && ! -s "$LILA/conf/application.conf" ]] && rm "$LILA/conf/application.conf"
  native_db_up
  ui_built || native_ui
  start_bg lila-ws "$WS" sbt --server run
  start_bg lila "$LILA" ./lila.sh --server run
  say "waiting for lila on :9663 (compiles first; can take 5+ minutes)"
  if wait_http http://localhost:9663/ 900; then say "up: $(site_url)"
  else die "lila did not answer within 15 minutes; see .ligo/logs/lila.log"; fi
  native_after_sbt
}

native_down() {
  stop_bg lila
  stop_bg lila-ws
  (cd "$LD" && run docker compose -f compose.native.yml --profile redis down)
}

# --------------------------------------------------------------------------------------------
# commands

cmd_compile() {
  local what=${1:-all}
  case "$MODE:$what" in
    docker:lila) docker_sbt lila compile ;;
    docker:ws) docker_sbt lila_ws compile ;;
    docker:ui) docker_env; docker_ui ;;
    native:lila) lila_sbt compile; native_after_sbt ;;
    native:ws) sbt1 "$WS" compile; native_after_sbt ;;
    native:ui) native_ui ;;
    docker:rules) docker_rules_sbt Test/compile ;;
    native:rules) sbt1 "$RULES" Test/compile; native_after_sbt ;;
    *:all) cmd_compile ui; cmd_compile lila; cmd_compile ws; cmd_compile rules ;;
    *) die "compile what? lila, ws, ui, rules or all" ;;
  esac
}

cmd_test() {
  local what=${1:-all}
  case "$MODE:$what" in
    docker:lila) docker_sbt lila test ;;
    docker:ws) docker_sbt lila_ws test ;;
    docker:ui) docker_env; run dc run --rm -w /lila ui pnpm test ;;
    native:lila) lila_sbt test; native_after_sbt ;;
    native:ws) sbt1 "$WS" test; native_after_sbt ;;
    native:ui) need_node_modules; (cd "$LILA" && run pnpm test) ;;
    # testFull: sbt 2's plain `test` only reruns tests whose code changed, and a fixture change
    # is not a code change.
    docker:rules) docker_rules_sbt testFull ;;
    native:rules) sbt1 "$RULES" testFull; native_after_sbt ;;
    *:all) cmd_test ui; cmd_test lila; cmd_test ws; cmd_test rules ;;
    *) die "test what? lila, ws, ui, rules or all" ;;
  esac
}

cmd_e2e() {
  local base; base=$(site_url)
  local ws_url=ws://localhost:9664
  [[ "$MODE" == docker ]] && ws_url=ws://localhost:8080
  say "smoke: GET $base/"
  local body; body=$(curl -sS -f "$base/") || die "home page did not answer 2xx"
  grep -q '<title>' <<<"$body" || die "home page has no <title>"
  say "  ok: $(grep -o '<title>[^<]*</title>' <<<"$body" | head -1)"
  say "smoke: websocket upgrade on the lobby socket"
  local code
  code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 --http1.1 \
    -H 'Connection: Upgrade' -H 'Upgrade: websocket' -H 'Sec-WebSocket-Version: 13' \
    -H 'Sec-WebSocket-Key: bGlnby1zbW9rZS10ZXN0IQ==' -H "Origin: $base" \
    "${ws_url/ws:/http:}/lobby/socket/v5?sri=ligosmoke$RANDOM" 2>/dev/null || true)
  [[ "$code" == 101 ]] || die "lobby websocket did not upgrade (HTTP $code)"
  say "  ok: 101 Switching Protocols"
  if [[ "${1:-}" == "--" ]]; then
    shift
    need_node_modules
    say "lila's Playwright suite (needs a seeded database for most specs; see lila/tests/README.md)"
    (cd "$LILA" && BASE_URL=$base run pnpm exec playwright test "$@")
  fi
}

cmd_deps() {
  [[ "$MODE" == native ]] || { say "docker mode fetches dependencies inside the containers; nothing to do"; return; }
  pnpm_install_lila
  lila_sbt update
  sbt1 "$WS" update
  sbt1 "$RULES" update
  native_after_sbt
}

cmd_status() {
  say "mode: $MODE"
  if [[ "$MODE" == docker ]]; then
    dc ps
  else
    local n
    for n in lila lila-ws; do
      if [[ -f "$STATE/$n.pid" ]] && kill -0 "$(cat "$STATE/$n.pid")" 2>/dev/null; then say "$n: running"; else say "$n: stopped"; fi
    done
    (cd "$LD" && docker compose -f compose.native.yml --profile redis ps)
  fi
}

cmd_logs() {
  local what=${1:-lila}
  if [[ "$MODE" == docker ]]; then
    case "$what" in lila) dc logs -f lila ;; ws) dc logs -f lila_ws ;; db) dc logs -f mongodb ;; *) dc logs -f "$what" ;; esac
  else
    case "$what" in
      lila) tail -F "$STATE/logs/lila.log" ;;
      ws) tail -F "$STATE/logs/lila-ws.log" ;;
      db) (cd "$LD" && docker compose -f compose.native.yml logs -f mongodb) ;;
      *) die "logs lila, ws or db" ;;
    esac
  fi
}

main() {
  local cmd=${1:-help}; shift || true
  case "$cmd" in
    up) if [[ "$MODE" == docker ]]; then docker_up; else native_up; fi ;;
    down) if [[ "$MODE" == docker ]]; then run dc --profile utils --profile mongo-express down; else native_down; fi ;;
    db) if [[ "$MODE" == docker ]]; then docker_env; run dc up -d mongodb mongodb_secondary redis; else native_db_up; fi ;;
    status) cmd_status ;;
    logs) cmd_logs "$@" ;;
    compile) cmd_compile "$@" ;;
    test) cmd_test "$@" ;;
    e2e) cmd_e2e "$@" ;;
    deps) cmd_deps ;;
    verify-mirror) verify_mirror ;;
    katago) exec "$ROOT/dev/katago.sh" "$@" ;;
    doctor) exec "$ROOT/dev/doctor.sh" "$@" ;;
    mode) echo "$MODE" ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
