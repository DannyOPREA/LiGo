#!/usr/bin/env bash
# ligo: one command for the LiGo dev stack (docs/CLAUDE_SETUP.md §3, §12).
#
# Two modes, same commands:
#   docker  (default on your own machine) wraps dev/lila-docker/, our trimmed copy of lichess's
#           lila-docker: everything runs in containers, the site is on http://localhost:8080
#   native  (default in Claude Code cloud sessions) runs sbt and pnpm on the host, with only Mongo
#           and Redis in Docker, as proven in unit 0.2: lila on :9663, lila-ws on :9664
# Override with LIGO_MODE=docker|native.
#
# Licence: MIT (LiGo's own code, ADR 0006).

set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
LD="$ROOT/dev/lila-docker"
STATE="$ROOT/.ligo"
LILA="$ROOT/lila"
WS="$ROOT/lila-ws"
RULES="$ROOT/libs/go-rules"

is_cloud() { [[ "${CLAUDE_CODE_REMOTE:-}" == "true" ]]; }
if [[ -n "${LIGO_MODE:-}" ]]; then MODE=$LIGO_MODE
elif is_cloud; then MODE=native
else MODE=docker; fi
[[ "$MODE" == docker || "$MODE" == native ]] || { echo "LIGO_MODE must be docker or native" >&2; exit 2; }

say() { printf '\033[1;34m[ligo]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[ligo] %s\033[0m\n' "$*" >&2; }
die() { printf '\033[1;31m[ligo] %s\033[0m\n' "$*" >&2; exit 1; }
run() { printf '\033[2m$ %s\033[0m\n' "$*"; "$@"; }

usage() {
  cat <<EOF
Usage: dev/ligo <command> [args]        (mode: $MODE)

  up                  Start the stack (first run builds the UI and compiles; takes a while).
                      Also starts the scoring Redis worker (unit 4.5): native mode with real
                      KataGo if installed, docker mode with none yet (answers every propose
                      src:"none" until a later unit gives it a KataGo story)
  down                Stop the stack (database data is kept)
  db                  Start only Mongo and Redis (idempotent; the SessionStart hook runs it)
  status              Show what is running
  logs [lila|ws|db|scoring]  Follow logs
  compile [what]      Compile lila, ws, ui, rules or all (default: all)
  test [what]         Run the unit tests of lila, ws, ui, pages, budget, rules, board, scoring, puzzles or all
                      (default: all, which leaves out budget); budget = the size budget and the
                      board's mount time, after rebuilding the ui minified (it stays minified);
                      pages = the playground's screenshots and scripted game in
                      Chromium, from the built ui (compile ui first; docker mode skips them);
                      rules = both Go rules engines: libs/go-rules (server) and libs/board
                      (goban-engine) replaying the libs/conformance fixtures, then the parity
                      check between them, plus the board in Chromium; board = the libs/board
                      tests alone, without parity (docker mode skips the Chromium ones); scoring =
                      services/scoring's own tests (OGS's 31 autoscore games, the libs/conformance
                      scoring fixtures, KataGo client, no build step), plus a real-KataGo test when
                      KataGo is installed (docker mode: not yet, unit 4.5); puzzles = tools/puzzles'
                      tests (solver, catalogue, frame, puzzle checks, SGF), with a real-KataGo test
                      when KataGo is installed, then 'puzzles check' over the committed set
  e2e [demo|-- args]  Smoke-test the running stack (home page + lobby websocket); with demo,
                      also play the Phase 3 demo game in two browsers (desktop and phone,
                      unit 3.20); with args after --, also run lila's Playwright suite with them
  deps                Fetch dependencies (sbt update, frozen pnpm install); native mode only
  verify-mirror       Cross-check Google-mirror downloads against Maven Central (cloud, ADR 0008)
  katago <cmd>        KataGo: install [cpu|opencl], smoke, bench, path, env (dev/katago.sh)
  scoring bench [args] The autoscore benchmark (unit 4.6): the real propose path (real KataGo) over
                      the vendored OGS games; args: --net PATH --games DIR --gate N --runs N (3)
                      --limit N --timeout MS; report in .ligo/scoring-bench/. Native mode only.
  puzzles <cmd>       The tsumego pipeline (unit 8.3, ADR 0025): build --out FILE [--seed N]
                      [--count N] (needs KataGo), check [FILE...] (default: tools/puzzles/data),
                      gate [--seed N] [--need N] (the solver's feasibility gate), sgf FILE [ID],
                      import SGF META (a hand-transcribed problem). Native mode only, except
                      load: puts tools/puzzles/data's puzzles in lila's database (unit 8.6;
                      up runs it when the database has no puzzles)
  differential [args] Random games checked against KataGo (unit 1.9): libs/go-rules vs KataGo on
                      legality, captures and area score; args: --games N (1000) --seed S
                      --workers W; report in .ligo/differential/. Native mode only; CI runs it
                      nightly (.github/workflows/nightly-differential.yml)
  doctor              Check this machine's tools (dev/doctor.sh)
  mode                Print the mode (docker or native)

Site: $(site_url)
EOF
}

site_url() { if [[ "$MODE" == docker ]]; then echo "http://localhost:8080"; else echo "http://localhost:9663"; fi; }

# ui/build writes manifest.json last, so a half-finished build doesn't count as built. A build
# older than any browser source (say, a git pull that brought a new page) doesn't count either:
# `up` would otherwise keep serving it, and the new page's script would 404.
ui_manifest() { echo "$LILA/public/compiled/manifest.json"; }
ui_newer_source() {  # prints the first browser source newer than the build, if any
  find "$LILA/ui" "$ROOT/libs/board" "$LILA/package.json" "$LILA/pnpm-lock.yaml" \
    \( -name node_modules -o -name dist -o -name coverage -o -name test-results -o -name playwright-report \) -prune \
    -o -type f ! -name '*.tsbuildinfo' -newer "$(ui_manifest)" -print -quit 2>/dev/null
}
ui_built() { [[ -f "$(ui_manifest)" && -z "$(ui_newer_source)" ]]; }
ui_state() {
  if [[ ! -f "$(ui_manifest)" ]]; then echo "not built (dev/ligo compile ui)"
  elif [[ -n "$(ui_newer_source)" ]]; then echo "out of date (dev/ligo compile ui)"
  else echo "up to date"; fi
}

# --------------------------------------------------------------------------------------------
# docker mode (wraps dev/lila-docker)

dc() { (cd "$LD" && docker compose "$@"); }

docker_env() {
  # Same logic as upstream lila-docker's write_user_id_to_env: files written by containers
  # into lila/ belong to you, except on Docker Desktop, which maps ownership itself.
  if docker info 2>/dev/null | grep -q "Operating System: Docker Desktop"; then
    printf 'USER_ID=0\nGROUP_ID=0\n' > "$LD/.env"
  else
    printf 'USER_ID=%s\nGROUP_ID=%s\n' "$(id -u)" "$(id -g)" > "$LD/.env"
  fi
  mkdir -p "$LD/.pnpm-store"
}

docker_ui() {
  run dc run --rm -w /lila ui pnpm install --frozen-lockfile
  run dc run --rm -w /lila ui ./ui/build --no-install --debug
}

docker_up() {
  docker_env
  run dc build
  run dc --profile utils build ui
  ui_built || docker_ui
  run dc up -d
  if [[ ! -f "$STATE/docker-db-initialised" ]]; then
    say "waiting for mongodb, then creating lila's indexes (first run only)"
    until dc exec -T mongodb mongosh --quiet --eval 'db.runCommand({ping: 1})' >/dev/null 2>&1; do sleep 2; done
    until dc exec -T mongodb mongosh --quiet --eval 'rs.isMaster().ismaster' 2>/dev/null | grep -q true; do sleep 2; done
    run dc exec -T mongodb mongosh --quiet lichess /lila/bin/mongodb/indexes.js
    run dc exec -T mongodb mongosh --quiet lichess /lila/bin/mongodb/create-trophy-kinds.js
    mkdir -p "$STATE" && touch "$STATE/docker-db-initialised"
  fi
  puzzles_seed
  say "lila compiles on first start (several minutes). Follow it with: dev/ligo logs lila"
  say "then open $(site_url)"
}

docker_sbt() {  # docker_sbt <service> <sbt args...>
  local svc=$1; shift
  if [[ -n "$(dc ps -q "$svc" 2>/dev/null)" ]]; then run dc exec -T "$svc" sbt "$@"
  else run dc run --rm --no-deps --entrypoint sbt "$svc" "$@"; fi
}

# libs/go-rules is its own sbt build; in docker mode it runs in the lila container, which mounts
# libs/ next to lila (compose.yml, unit 3.10), so its tests find ../conformance/fixtures. Its
# downloads (sbt, Scala, strategygames) go to .ligo/rules-cache, so they survive the throwaway
# container and libs/go-rules/check-pin.sh can check the jar from the host.
docker_rules_sbt() {
  mkdir -p "$STATE/rules-cache"
  run dc run --rm --no-deps -v "$STATE/rules-cache:/rules-cache" \
    -e COURSIER_CACHE=/rules-cache/coursier \
    -e SBT_OPTS="-Dsbt.boot.directory=/rules-cache/sbt/boot -Dsbt.global.base=/rules-cache/sbt/global -Dsbt.ivy.home=/rules-cache/ivy2" \
    -w /libs/go-rules --entrypoint sbt lila "$@"
}

# libs/board is a member of lila's pnpm workspace (unit 2.1): its packages come from lila's lockfile,
# installed for it alone with --filter, and its scripts run from lila/ with --filter too (pnpm run
# inside libs/board wouldn't find the workspace). In docker mode the ui container sees it at
# /libs/board (compose.yml mounts libs/). Its browser tests need Chromium, which the ui container
# doesn't have: docker mode runs the Node tests and says so; native mode and CI run them all.
board_pnpm() { echo "pnpm install --frozen-lockfile --filter @ligo/board --filter lila && pnpm --filter @ligo/board run $1"; }
docker_board() {
  docker_env
  local script=test:node
  [[ "$1" == test:all ]] && script=test:node-all
  run dc run --rm --no-deps -w /lila ui sh -c "$(board_pnpm "$script")"
  say "board browser tests skipped in docker mode (no Chromium in the ui container); CI runs them"
}
native_board() { (cd "$LILA" && run sh -c "$(board_pnpm typecheck) && pnpm --filter @ligo/board run $1"); }

# services/scoring is also a member of lila's pnpm workspace (unit 4.4, same reasoning as
# libs/board, ADR 0017): one lockfile, goban-engine pinned to the same 8.3.226 both packages use.
# No build step (Node 24 runs its .ts directly): "test" typechecks nothing itself, so this runs
# typecheck, lint and the tests together. Its tests need KataGo installed to run the real-KataGo
# integration test, and are skipped otherwise (test/integration.test.ts); everything else runs
# with no KataGo at all. This test runner has no container of its own (the ui container has no
# KataGo), so it says so rather than pretending to test it; the live worker docker mode actually
# runs (dev/ligo up) is the separate `scoring` compose service, below.
scoring_pnpm() { echo "pnpm install --frozen-lockfile --filter @ligo/scoring --filter lila && pnpm --filter @ligo/scoring run $1"; }
docker_scoring() {
  say "scoring service tests skipped in docker mode (no KataGo in the ui container); native mode and CI run them"
}
native_scoring() {
  # When KataGo is installed, load KATAGO_BIN/KATAGO_TEST_NET/KATAGO_GTP_CONFIG (dev/katago.sh
  # env, same as cmd_differential below) so test/integration.test.ts's real-KataGo test runs
  # instead of skipping; when it isn't installed, leave them unset and that one test skips itself.
  local katago_env
  if katago_env=$("$ROOT/dev/katago.sh" env 2>/dev/null); then
    eval "$katago_env"
    export KATAGO_BIN KATAGO_TEST_NET KATAGO_NET KATAGO_GTP_CONFIG
  fi
  (cd "$LILA" && run sh -c "$(scoring_pnpm typecheck) && pnpm --filter @ligo/scoring run lint && pnpm --filter @ligo/scoring run test")
}

# tools/puzzles (unit 8.3, ADR 0025): also in lila's pnpm workspace, beside services/scoring,
# whose KataGo client it imports by path (as it does libs/board's SGF reader), so those two
# packages' node_modules are installed with it. No docker-mode support: the ui container mounts
# neither tools/ nor KataGo.
puzzles_install() { echo "pnpm install --frozen-lockfile --filter @ligo/puzzles --filter @ligo/scoring --filter @ligo/board --filter lila"; }
puzzles_katago_env() {
  local katago_env
  if katago_env=$("$ROOT/dev/katago.sh" env 2>/dev/null); then
    eval "$katago_env"
    export KATAGO_BIN KATAGO_TEST_NET KATAGO_NET
  fi
}
native_puzzles() {
  puzzles_katago_env
  (cd "$LILA" && run sh -c "$(puzzles_install) && pnpm --filter @ligo/puzzles run typecheck && pnpm --filter @ligo/puzzles run lint && pnpm --filter @ligo/puzzles run test")
  (cd "$ROOT" && run node tools/puzzles/src/cli.ts check)
}
# `puzzles load` (unit 8.6, ADR 0025 §5): tools/puzzles/mongo/load.js upserts the committed
# puzzles into lila's puzzle collection, run by mongosh in the mongodb container (both modes, no
# host Node needed). The puzzles go in through stdin: 300 KB is over Linux's 128 KB limit for one
# argument, so `--eval` can't carry them. lila's puzzle path job builds puzzle2_path from them.
mongo_exec() {
  if [[ "$MODE" == docker ]]; then dc exec -T mongodb "$@"; else (cd "$LD" && docker compose -f compose.native.yml exec -T mongodb "$@"); fi
}
puzzles_script() {
  local f sep=''
  printf 'const puzzles = [].concat(\n'
  for f in "$ROOT"/tools/puzzles/data/*.json; do printf '%s' "$sep"; cat "$f"; sep=','; done
  printf ');\n'
  cat "$ROOT/tools/puzzles/mongo/doc.js" "$ROOT/tools/puzzles/mongo/load.js"
}
puzzles_load() {
  say "loading tools/puzzles/data into lila's puzzle collection"
  # shellcheck disable=SC2016 # expanded by the container's sh
  puzzles_script | mongo_exec sh -c 'cat > /tmp/ligo-puzzles.js && mongosh --quiet lichess /tmp/ligo-puzzles.js; s=$?; rm -f /tmp/ligo-puzzles.js; exit $s'
}
puzzles_seed() {  # on an empty database only; a failure here never stops `up`
  local n
  n=$(mongo_exec mongosh --quiet lichess --eval 'db.puzzle2_puzzle.estimatedDocumentCount()' 2>/dev/null) ||
    { say "puzzles: Mongo not ready, skipped; run dev/ligo puzzles load"; return 0; }
  [[ "$n" == 0 ]] && { puzzles_load || say "puzzles: load failed; run dev/ligo puzzles load"; }
  return 0
}
cmd_puzzles() {
  if [[ "${1:-}" == load ]]; then puzzles_load; return; fi
  [[ "$MODE" == native ]] || die "puzzles runs on the host: LIGO_MODE=native dev/ligo puzzles ... (needs host Node and pnpm)"
  [[ $# -gt 0 ]] || die "puzzles build|check|gate|sgf|import [args] (dev/ligo help)"
  puzzles_katago_env
  (cd "$LILA" && run sh -c "$(puzzles_install)")
  (cd "$ROOT" && run node tools/puzzles/src/cli.ts "$@")
}

# services/scoring's Redis worker (unit 4.5, ADR 0020 §1: `scoring-in`/`scoring-out`, `start` on
# boot). Native mode: supervised like lila/lila-ws (its own pid and log under .ligo/), but with its
# own small restart loop rather than start_bg/stop_bg's generic wrapper — that wrapper (a
# `tail -f /dev/null` piped into the command, see start_bg's own comment) exists only to keep
# stdin open for Play, which this plain Node process doesn't need, and it would also hide a dead
# worker from `dev/ligo status` (the piped `tail` stays alive even after the command it's piped
# into has exited). KataGo is best-effort: if `dev/ligo katago install` has already run, the
# worker gets KATAGO_BIN/KATAGO_MODEL/KATAGO_CONFIG (the test network `katago env` also gives CI
# and the differential test — weak, but real KataGo plumbing rather than a full-size net a dev box
# may not have); otherwise the worker starts anyway with none of them set, and every `propose`
# answers `src:"none"` (ADR 0020 §4's own fallback), same as a KataGo that crashed.
#
# Docker mode (decision, unit 4.5, logs/decisions.md): dev/lila-docker/compose.yml's `scoring`
# service runs the worker with NO KataGo env at all (no container has KataGo yet — no OpenCL
# passthrough to the owner's GPU, no binary staged into an image), so it always answers
# `src:"none"`, same fallback as native mode with no KataGo installed; `dev/ligo up`/`down` start
# and stop it like every other compose service (it isn't behind a profile), and `status`/
# `logs scoring` read it from `docker compose`. A later unit can give docker mode a real KataGo
# without changing this shape, only the compose service's environment.
scoring_katago_env() {
  local envout
  if ! envout=$("$ROOT/dev/katago.sh" env 2>/dev/null); then
    say "scoring worker: KataGo not installed (dev/ligo katago install); every propose will answer src:\"none\""
    return
  fi
  eval "$envout"
  export KATAGO_BIN
  export KATAGO_MODEL="$KATAGO_TEST_NET"
  local cfg
  cfg="$(dirname "$(readlink -f "$KATAGO_BIN")")/analysis_example.cfg"
  export KATAGO_CONFIG="$cfg"
}
native_scoring_worker_up() {
  need_node_modules
  scoring_katago_env
  start_bg_restart scoring-worker "$LILA" pnpm --filter @ligo/scoring run start
}
native_scoring_worker_down() { stop_bg scoring-worker; }

# The autoscore benchmark (unit 4.6, PLAN §5 row 4.6): the real `propose` path (a real KataGo, not
# stored ownership maps) over the vendored OGS games, grading autoscore's answer against each
# game's correct_ownership, N runs (KataGo is not deterministic). Needs a real KataGo (dev/ligo katago install); `--gate N` fails the command below N%
# (the owner runs that with the b18 network on his GPU — see dev/ligo katago --help and this
# command's own --net). No docker-mode support yet (same reason as native_scoring above).
cmd_scoring_bench() {
  [[ "$MODE" == native ]] || die "scoring bench runs on the host: LIGO_MODE=native dev/ligo scoring bench ... (needs host Node and pnpm; no KataGo in any container yet)"
  local katago_env
  katago_env=$("$ROOT/dev/katago.sh" env) || die "KataGo is not installed: run dev/ligo katago install"
  eval "$katago_env"
  export KATAGO_BIN KATAGO_NET
  (cd "$LILA" && run pnpm install --frozen-lockfile --filter @ligo/scoring --filter lila)
  mkdir -p "$STATE/scoring-bench"
  (cd "$LILA" && run pnpm --filter @ligo/scoring run bench -- --out "$STATE/scoring-bench/report.json" "$@")
}

cmd_scoring() {
  local sub=${1:-bench}; shift || true
  case "$sub" in
    bench) cmd_scoring_bench "$@" ;;
    *) die "scoring bench [--net PATH] [--games DIR] [--gate N] [--runs N] [--limit N] [--timeout MS]" ;;
  esac
}

# --------------------------------------------------------------------------------------------
# native mode (host sbt + pnpm; Mongo and Redis in Docker)

sbt1() { (cd "$1" && shift && run sbt --server --batch "$@"); }   # one-shot, no background server
lila_sbt() { (cd "$LILA" && run ./lila.sh --server --batch "$@"); }

native_after_sbt() { if is_cloud; then verify_mirror; fi; }

need_node_modules() {
  [[ -d "$LILA/node_modules" && -d "$LILA/ui/.build/node_modules" ]] || die "run dev/ligo deps first"
}

native_ui() { need_node_modules; (cd "$LILA" && CI=1 run ./ui/build --no-install --debug); }

pnpm_install_lila() {
  (cd "$LILA/ui/.build" && run pnpm install --frozen-lockfile)
  if is_cloud; then
    ab_stub_install
  else
    (cd "$LILA" && run pnpm install --frozen-lockfile)
  fi
}

# ADR 0008 step 3. The session's GitHub proxy refuses codeload.github.com tarballs, so build the
# ab-stub tarball from a git clone, check it against the lockfile integrity, point only that
# lockfile URL at the local file for the install, then restore the lockfile.
ab_stub_install() {
  local lock="$LILA/pnpm-lock.yaml" line url sha want tmp tgz got
  line=$(grep -m1 -E 'tarball: https://codeload.github.com/lichess-org/ab-stub/tar.gz/[0-9a-f]{40}' "$lock") \
    || die "ab-stub entry not found in pnpm-lock.yaml"
  url=$(grep -oE 'https://codeload.github.com/lichess-org/ab-stub/tar.gz/[0-9a-f]{40}' <<<"$line" | head -1)
  sha=${url##*/}
  want=$(grep -oE 'integrity: sha512-[A-Za-z0-9+/=]+' <<<"$line" | sed 's/integrity: sha512-//')
  mkdir -p "$STATE/cache"
  tgz="$STATE/cache/ab-stub-$sha.tar.gz"
  if [[ ! -f "$tgz" ]]; then
    tmp=$(mktemp -d)
    run git -C "$tmp" init -q
    run git -C "$tmp" fetch -q --depth 1 https://github.com/lichess-org/ab-stub "$sha"
    git -C "$tmp" archive --format=tar.gz --prefix="ab-stub-$sha/" "$sha" > "$tgz.part"
    rm -rf "$tmp"
    mv "$tgz.part" "$tgz"
  fi
  got=$(openssl dgst -sha512 -binary "$tgz" | base64 -w0)
  [[ "$got" == "$want" ]] || { rm -f "$tgz"; die "ab-stub tarball sha512 mismatch (got $got, want $want)"; }
  say "ab-stub tarball matches the lockfile integrity"
  cp "$lock" "$STATE/cache/pnpm-lock.yaml.orig"
  # Restore the lockfile even if we're interrupted (e.g. the setup script's time limit).
  trap 'cp "$STATE/cache/pnpm-lock.yaml.orig" "$LILA/pnpm-lock.yaml"' EXIT
  trap 'exit 130' INT TERM
  sed -i "s#tarball: $url#tarball: file:$tgz#" "$lock"
  local rc=0
  (cd "$LILA" && run pnpm install --frozen-lockfile) || rc=$?
  cp "$STATE/cache/pnpm-lock.yaml.orig" "$lock"
  trap - EXIT INT TERM
  git -C "$ROOT" diff --quiet -- lila/pnpm-lock.yaml || die "pnpm-lock.yaml was not restored"
  return $rc
}

# ADR 0008 step 2. coursier checks only same-origin checksums, so compare every file fetched from
# Google's mirror with the SHA-1 Maven Central publishes. Verified files are remembered.
verify_mirror() {
  local cache="${COURSIER_CACHE:-$HOME/.cache/coursier/v1}"
  local mirror="$cache/https/maven-central.storage-download.googleapis.com/maven2"
  local db="$STATE/mirror-verified.txt" todo out
  [[ -d "$mirror" ]] || { say "no Google-mirror downloads to verify"; return 0; }
  mkdir -p "$STATE"; touch "$db"
  todo=$(mktemp); out=$(mktemp)
  (cd "$mirror" && find . -type f ! -name '.*' ! -name '*.sha1' ! -name '*.md5' ! -name '*.sha256' \
      ! -name '*.sha512' ! -name '*.asc' ! -name '*.part' ! -name '*.lock' | sed 's#^\./##' | sort) \
    | comm -23 - <(cut -d' ' -f2 "$db" | sort) > "$todo"
  local n; n=$(wc -l < "$todo")
  if (( n == 0 )); then say "mirror cross-check: nothing new ($(wc -l < "$db") files verified before)"; rm -f "$todo" "$out"; return 0; fi
  say "mirror cross-check: comparing $n new files with Maven Central's SHA-1s"
  export MIRROR_DIR="$mirror"
  # shellcheck disable=SC2016 # the script runs in the child bash, so single quotes are intended
  xargs -P 8 -I{} bash -c '
    f={}; local_sha=$(sha1sum "$MIRROR_DIR/$f" | cut -c1-40)
    for i in 1 2 3 4 5 6 7 8; do
      code=$(curl -sS -o /tmp/ligo-sha.$$ -w "%{http_code}" "https://repo1.maven.org/maven2/$f.sha1" 2>/dev/null || echo 000)
      [[ "$code" == 200 ]] && break
      [[ "$code" == 404 ]] && break
      sleep $((i * 2))
    done
    remote=$(grep -oE "[0-9a-f]{40}" /tmp/ligo-sha.$$ 2>/dev/null | head -1); rm -f /tmp/ligo-sha.$$
    if [[ "$code" != 200 || -z "$remote" ]]; then echo "UNVERIFIED $code $f"
    elif [[ "$remote" == "$local_sha" ]]; then echo "OK $local_sha $f"
    else echo "MISMATCH $local_sha!=$remote $f"; fi
  ' < "$todo" > "$out"
  grep '^OK ' "$out" | cut -d' ' -f2- >> "$db" || true
  local ok bad unv
  ok=$(grep -c '^OK ' "$out" || true); bad=$(grep -c '^MISMATCH ' "$out" || true); unv=$(grep -c '^UNVERIFIED ' "$out" || true)
  say "mirror cross-check: $ok matched, $bad mismatched, $unv could not be checked ($(wc -l < "$db") verified in total)"
  if (( bad > 0 || unv > 0 )); then
    grep -v '^OK ' "$out" | head -20 >&2
    rm -f "$todo" "$out"
    die "mirror cross-check failed: do not use these artifacts; tell the owner (ADR 0008)"
  fi
  rm -f "$todo" "$out"
}

port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

native_db_up() {
  local profiles=()
  if port_open 6379 && ! (cd "$LD" && docker compose -f compose.native.yml --profile redis ps -q redis | grep -q .); then
    say "using the redis already listening on 6379"
  else
    profiles=(--profile redis)
  fi
  (cd "$LD" && run docker compose -f compose.native.yml "${profiles[@]}" up -d)
  say "waiting for mongodb"
  until port_open 27017; do sleep 1; done
  if [[ ! -f "$STATE/native-db-initialised" ]]; then
    (cd "$LD" && docker compose -f compose.native.yml exec -T mongodb sh -c 'until mongosh --quiet --eval "db.runCommand({ping:1})" >/dev/null 2>&1; do sleep 1; done')
    (cd "$LD" && docker compose -f compose.native.yml exec -T mongodb mongosh --quiet lichess --eval "$(cat "$LILA/bin/mongodb/indexes.js")") >/dev/null
    (cd "$LD" && docker compose -f compose.native.yml exec -T mongodb mongosh --quiet lichess --eval "$(cat "$LILA/bin/mongodb/create-trophy-kinds.js")") >/dev/null
    mkdir -p "$STATE" && touch "$STATE/native-db-initialised"
    say "created lila's indexes"
  fi
  puzzles_seed
}

start_bg() {  # start_bg <name> <dir> <command...>: survives this shell; stdin kept open for Play
  local name=$1 dir=$2; shift 2
  local pidf="$STATE/$name.pid"
  if [[ -f "$pidf" ]] && kill -0 "$(cat "$pidf")" 2>/dev/null; then say "$name already running"; return; fi
  mkdir -p "$STATE/logs"
  # The child records its own pid: it leads a new session and process group, so stop_bg can
  # signal the whole group (setsid may fork, so $! is not reliable).
  rm -f "$pidf"
  # shellcheck disable=SC2016 # expanded by the child bash
  (cd "$dir" && setsid bash -c 'echo $$ > "$0"; tail -f /dev/null | "$@"' "$pidf" "$@" </dev/null >"$STATE/logs/$name.log" 2>&1 &)
  for _ in $(seq 50); do [[ -s "$pidf" ]] && break; sleep 0.1; done
  say "started $name (log: .ligo/logs/$name.log)"
}

stop_bg() {
  local name=$1 pidf="$STATE/$1.pid" pid
  [[ -f "$pidf" ]] || return 0
  pid=$(cat "$pidf")
  if kill -0 "$pid" 2>/dev/null; then
    kill -TERM -- "-$pid" 2>/dev/null || true
    for _ in $(seq 20); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    kill -KILL -- "-$pid" 2>/dev/null || true
    say "stopped $name"
  fi
  rm -f "$pidf"
}

# start_bg_restart <name> <dir> <command...>: like start_bg, but the recorded pid is a small
# supervisor loop (not a `tail -f /dev/null` pipe) that re-runs <command...> with a capped
# exponential backoff whenever it exits, as long as the pid file still exists. Used for the
# scoring worker (unit 4.5): plain Node processes don't need start_bg's stdin-open trick, and a
# crashed worker coming back on its own means `dev/ligo status` reporting "running" stays true
# rather than describing a dead process a generic wrapper happened to outlive. stop_bg (above)
# stops it the same way: SIGTERM to the whole process group, which reaches the loop and its
# current child together, then removing the pid file so the loop (if still alive) won't restart.
start_bg_restart() {
  local name=$1 dir=$2; shift 2
  local pidf="$STATE/$name.pid"
  if [[ -f "$pidf" ]] && kill -0 "$(cat "$pidf")" 2>/dev/null; then say "$name already running"; return; fi
  mkdir -p "$STATE/logs"
  rm -f "$pidf"
  # shellcheck disable=SC2016 # expanded by the child bash; $0 is the name (for the log line), $1
  # the pid file, the rest the command to supervise.
  (cd "$dir" && setsid bash -c '
    echo $$ > "$1"
    name=$0; pidfile=$1; shift
    backoff=1
    while [[ -f "$pidfile" ]]; do
      "$@"
      code=$?
      [[ -f "$pidfile" ]] || break
      echo "[ligo] $name exited (code $code); restarting in ${backoff}s" >&2
      sleep "$backoff"
      if (( backoff < 30 )); then backoff=$(( backoff * 2 )); else backoff=30; fi
    done
  ' "$name" "$pidf" "$@" </dev/null >"$STATE/logs/$name.log" 2>&1 &)
  for _ in $(seq 50); do [[ -s "$pidf" ]] && break; sleep 0.1; done
  say "started $name (log: .ligo/logs/$name.log)"
}

wait_http() {  # wait_http <url> <seconds>
  local url=$1 limit=$2 t=0
  until [[ "$(curl -s -o /dev/null -w '%{http_code}' "$url" || true)" =~ ^[23] ]]; do
    (( t >= limit )) && return 1
    sleep 5; t=$((t + 5))
  done
}

native_up() {
  need_node_modules
  # A container-created empty application.conf (docker mode's bind mount) would stop lila.sh
  # from copying the default config.
  [[ -f "$LILA/conf/application.conf" && ! -s "$LILA/conf/application.conf" ]] && rm "$LILA/conf/application.conf"
  native_db_up
  ui_built || native_ui
  start_bg lila-ws "$WS" sbt --server run
  start_bg lila "$LILA" ./lila.sh --server run
  native_scoring_worker_up
  say "waiting for lila on :9663 (compiles first; can take 5+ minutes)"
  if wait_http http://localhost:9663/ 900; then say "up: $(site_url)"
  else die "lila did not answer within 15 minutes; see .ligo/logs/lila.log"; fi
  native_after_sbt
}

native_down() {
  stop_bg lila
  stop_bg lila-ws
  native_scoring_worker_down
  (cd "$LD" && run docker compose -f compose.native.yml --profile redis down)
}

# --------------------------------------------------------------------------------------------
# commands

cmd_compile() {
  local what=${1:-all}
  case "$MODE:$what" in
    docker:lila) docker_sbt lila compile ;;
    docker:ws) docker_sbt lila_ws compile ;;
    docker:ui) docker_env; docker_ui ;;
    native:lila) lila_sbt compile; native_after_sbt ;;
    native:ws) sbt1 "$WS" compile; native_after_sbt ;;
    native:ui) native_ui ;;
    docker:rules) docker_rules_sbt Test/compile ;;
    native:rules) sbt1 "$RULES" Test/compile; native_after_sbt ;;
    *:all) cmd_compile ui; cmd_compile lila; cmd_compile ws; cmd_compile rules ;;
    *) die "compile what? lila, ws, ui, rules or all" ;;
  esac
}

cmd_test() {
  local what=${1:-all}
  case "$MODE:$what" in
    docker:lila) docker_sbt lila test ;;
    docker:ws) docker_sbt lila_ws test ;;
    docker:ui) docker_env; run dc run --rm -w /lila ui pnpm test ;;
    native:lila) lila_sbt test; native_after_sbt ;;
    native:ws) sbt1 "$WS" test; native_after_sbt ;;
    native:ui) need_node_modules; (cd "$LILA" && run pnpm test) ;;
    # testFull: sbt 2's plain `test` only reruns tests whose code changed, and a fixture change
    # is not a code change. It also writes target/parity/server.json, which test:all replays.
    # The strategygames jar's SHA-256 is checked after it is downloaded and before tests run it.
    docker:rules) docker_rules_sbt update; run "$RULES/check-pin.sh"; docker_rules_sbt testFull; docker_board test:all ;;
    native:rules) sbt1 "$RULES" update; run "$RULES/check-pin.sh"; sbt1 "$RULES" testFull; native_after_sbt; native_board test:all ;;
    docker:board) docker_board test ;;
    native:board) native_board test ;;
    # The playground's screenshots and scripted game (unit 2.4), the round page's game against a
    # stand-in server (unit 3.18), the lobby's quick pairing (unit 6.6), the analysis board (unit 7.4) and the puzzle trainer (unit 8.7),
    # from the built ui in Chromium.
    docker:pages) say "page browser tests skipped in docker mode (no Chromium in the ui container); CI runs them" ;;
    native:pages)
      need_node_modules
      if ui_built; then (cd "$LILA" && run pnpm exec playwright test -c ui/playground/e2e/playwright.config.ts \
        && run pnpm exec playwright test -c ui/round/e2e/playwright.config.ts \
        && run pnpm exec playwright test -c ui/lobby/e2e/playwright.config.ts \
        && run pnpm exec playwright test -c ui/analyse/e2e/playwright.config.ts \
        && run pnpm exec playwright test -c ui/puzzle/e2e/playwright.config.ts)
      else say "page browser tests skipped: build the ui first (dev/ligo compile ui)"; fi ;;
    # LiGo's performance budget (ADR 0026 §5, unit 9.5): sizes of the production build, then the
    # board's mount time in Chromium. Rebuilds the ui with -p (minified), as CI measures it.
    docker:budget) say "budget check skipped in docker mode (no Chromium in the ui container); CI runs it" ;;
    native:budget)
      need_node_modules
      (cd "$LILA" && run ./ui/build --no-install -p && run node ../dev/ci/budget.mjs \
        && run pnpm exec playwright test -c ui/playground/e2e/playwright.config.ts budget) ;;
    docker:scoring) docker_scoring ;;
    native:scoring) native_scoring ;;
    docker:puzzles) say "puzzle tests skipped in docker mode (the ui container has neither tools/ nor KataGo); native mode and CI run them" ;;
    native:puzzles) native_puzzles ;;
    *:all) cmd_test ui; cmd_test pages; cmd_test lila; cmd_test ws; cmd_test rules; cmd_test scoring; cmd_test puzzles ;;
    *) die "test what? lila, ws, ui, pages, budget, rules, board, scoring, puzzles or all" ;;
  esac
}

cmd_e2e() {
  local base; base=$(site_url)
  local ws_url=ws://localhost:9664
  [[ "$MODE" == docker ]] && ws_url=ws://localhost:8080
  say "smoke: GET $base/"
  local body; body=$(curl -sS -f "$base/") || die "home page did not answer 2xx"
  grep -q '<title>' <<<"$body" || die "home page has no <title>"
  say "  ok: $(grep -o '<title>[^<]*</title>' <<<"$body" | head -1)"
  say "smoke: websocket upgrade on the lobby socket"
  local code
  code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 --http1.1 \
    -H 'Connection: Upgrade' -H 'Upgrade: websocket' -H 'Sec-WebSocket-Version: 13' \
    -H 'Sec-WebSocket-Key: bGlnby1zbW9rZS10ZXN0IQ==' -H "Origin: $base" \
    "${ws_url/ws:/http:}/lobby/socket/v5?sri=ligosmoke$RANDOM" 2>/dev/null || true)
  [[ "$code" == 101 ]] || die "lobby websocket did not upgrade (HTTP $code)"
  say "  ok: 101 Switching Protocols"
  if [[ "${1:-}" == demo ]]; then
    shift
    need_node_modules
    say "the Phase 3 demo: two browsers play a casual 9x9 game from the lobby to a resignation"
    (cd "$LILA" && BASE_URL=$base run pnpm exec playwright test -c tests/e2e-demo/playwright.config.ts "$@")
  elif [[ "${1:-}" == "--" ]]; then
    shift
    need_node_modules
    say "lila's Playwright suite (needs a seeded database for most specs; see lila/tests/README.md)"
    (cd "$LILA" && BASE_URL=$base run pnpm exec playwright test "$@")
  fi
}

cmd_deps() {
  [[ "$MODE" == native ]] || { say "docker mode fetches dependencies inside the containers; nothing to do"; return; }
  pnpm_install_lila
  lila_sbt update
  sbt1 "$WS" update
  sbt1 "$RULES" update
  native_after_sbt
}

# The differential test (unit 1.9). Docker mode would need KataGo inside the lila container (and the
# OpenCL build there), so it runs natively; the nightly workflow runs it for everyone.
cmd_differential() {
  [[ "$MODE" == native ]] || die "differential runs in native mode; otherwise use the nightly-differential workflow's 'Run workflow' button on GitHub (Actions tab)"
  local a
  for a in "$@"; do [[ "$a" =~ ^[-A-Za-z0-9]+$ ]] || die "differential takes --games N --seed S --workers W (got '$a')"; done
  local env; env=$("$ROOT/dev/katago.sh" env) || die "KataGo is not installed: run dev/ligo katago install"
  eval "$env"
  export KATAGO_BIN KATAGO_TEST_NET KATAGO_GTP_CONFIG
  export DIFFERENTIAL_OUT="$STATE/differential"
  rm -rf "$DIFFERENTIAL_OUT"
  sbt1 "$RULES" update
  run "$RULES/check-pin.sh"
  sbt1 "$RULES" "Test/runMain ligo.gorules.differential.Differential $*"
}

cmd_status() {
  say "mode: $MODE"
  say "browser build: $(ui_state)"
  if [[ "$MODE" == docker ]]; then
    dc ps
  else
    local n
    for n in lila lila-ws scoring-worker; do
      if [[ -f "$STATE/$n.pid" ]] && kill -0 "$(cat "$STATE/$n.pid")" 2>/dev/null; then say "$n: running"; else say "$n: stopped"; fi
    done
    (cd "$LD" && docker compose -f compose.native.yml --profile redis ps)
  fi
}

cmd_logs() {
  local what=${1:-lila}
  if [[ "$MODE" == docker ]]; then
    case "$what" in
      lila) dc logs -f lila ;;
      ws) dc logs -f lila_ws ;;
      db) dc logs -f mongodb ;;
      scoring) dc logs -f scoring ;;
      *) dc logs -f "$what" ;;
    esac
  else
    case "$what" in
      lila) tail -F "$STATE/logs/lila.log" ;;
      ws) tail -F "$STATE/logs/lila-ws.log" ;;
      db) (cd "$LD" && docker compose -f compose.native.yml logs -f mongodb) ;;
      scoring) tail -F "$STATE/logs/scoring-worker.log" ;;
      *) die "logs lila, ws, db or scoring" ;;
    esac
  fi
}

main() {
  local cmd=${1:-help}; shift || true
  case "$cmd" in
    up) if [[ "$MODE" == docker ]]; then docker_up; else native_up; fi ;;
    down) if [[ "$MODE" == docker ]]; then run dc --profile utils --profile mongo-express down; else native_down; fi ;;
    db) if [[ "$MODE" == docker ]]; then docker_env; run dc up -d mongodb mongodb_secondary redis; else native_db_up; fi ;;
    status) cmd_status ;;
    logs) cmd_logs "$@" ;;
    compile) cmd_compile "$@" ;;
    test) cmd_test "$@" ;;
    e2e) cmd_e2e "$@" ;;
    deps) cmd_deps ;;
    verify-mirror) verify_mirror ;;
    katago) exec "$ROOT/dev/katago.sh" "$@" ;;
    scoring) cmd_scoring "$@" ;;
    puzzles) cmd_puzzles "$@" ;;
    differential) cmd_differential "$@" ;;
    doctor) exec "$ROOT/dev/doctor.sh" "$@" ;;
    mode) echo "$MODE" ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
