{
  "about": "How an SGF record's root properties become a LiGo position (ADR 0023 §2): one table replayed by libs/board's SGF reader (unit 7.2) and libs/go-rules' reader (unit 7.3), so a stored import always opens in the analysis board. `root` is the root node's properties (first value of each, as in the file; AB/AW as lists of points); `firstMove` is the colour of the main line's first move, if any. `expect` is the settings read, or `refused` names why the record is refused everywhere; `importRefused` names why the server refuses to store it though the analysis board opens it. Licence: MIT (LiGo's own, ADR 0006).",
  "cases": [
    { "id": "defaults", "root": {}, "expect": { "size": 19, "ruleset": "japanese", "komi": 0, "handicap": 0, "black": [], "white": [], "toMove": "black" } },
    { "id": "even-japanese", "root": { "SZ": "19", "RU": "Japanese", "KM": "6.5" }, "expect": { "size": 19, "ruleset": "japanese", "komi": 6.5, "handicap": 0, "black": [], "white": [], "toMove": "black" } },
    { "id": "nine-chinese", "root": { "SZ": "9", "RU": "Chinese", "KM": "7.5" }, "expect": { "size": 9, "ruleset": "chinese", "komi": 7.5, "handicap": 0, "black": [], "white": [], "toMove": "black" } },
    { "id": "square-size-pair", "root": { "SZ": "9:9" }, "expect": { "size": 9, "ruleset": "japanese", "komi": 0, "handicap": 0, "black": [], "white": [], "toMove": "black" } },
    { "id": "thirteen", "root": { "SZ": "13", "KM": "6.5" }, "expect": { "size": 13, "ruleset": "japanese", "komi": 6.5, "handicap": 0, "black": [], "white": [], "toMove": "black" }, "importRefused": "size" },
    { "id": "size-7", "root": { "SZ": "7" }, "refused": "size" },
