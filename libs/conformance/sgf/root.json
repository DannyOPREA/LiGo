    { "id": "first-move-white", "root": {}, "firstMove": "white", "expect": { "size": 19, "ruleset": "japanese", "komi": 0, "handicap": 0, "black": [], "white": [], "toMove": "white" } },
    { "id": "setup-both-colours", "root": { "SZ": "9", "AB": ["cc", "gg"], "AW": ["cg", "gc"] }, "expect": { "size": 9, "ruleset": "japanese", "komi": 0, "handicap": 0, "black": ["cc", "gg"], "white": ["cg", "gc"], "toMove": "black" } },
