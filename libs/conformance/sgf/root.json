    { "id": "handicap-stones-first-move-white", "root": { "HA": "4", "AB": ["dd", "dp", "pd", "pp"] }, "firstMove": "white", "expect": { "size": 19, "ruleset": "japanese", "komi": 0, "handicap": 4, "black": ["dd", "dp", "pd", "pp"], "white": [], "toMove": "white" } },
