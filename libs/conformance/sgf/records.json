{
  "about": "SGF records read by both libs/board's reader (`readTree`, unit 7.2) and libs/go-rules' import (`SgfImport`, unit 7.3), so a file reads the same in the browser and on the server (ADR 0023 §2, §3). `expect` is the main line (SGF points, `..` for a pass) and who moves after it; `refused` means both readers refuse the record (`move`: the move number named, when a move is the cause); `importRefused` means the analysis board reads it but the server won't store it. Licence: MIT (LiGo's own, ADR 0006).",
  "cases": [
    {"id": "even-game", "sgf": "(;GM[1]FF[4]SZ[9]KM[6.5];B[ee];W[cc];B[gg])", "expect": {"moves": ["ee", "cc", "gg"], "toMove": "white"}},
    {"id": "passes", "sgf": "(;SZ[9];B[ee];W[];B[dd])", "expect": {"moves": ["ee", "..", "dd"], "toMove": "white"}},
    {"id": "tt-pass-19", "sgf": "(;SZ[19];B[tt];W[pd])", "expect": {"moves": ["..", "pd"], "toMove": "black"}},
    {"id": "tt-off-board-9", "sgf": "(;SZ[9];B[tt])", "refused": {"move": 1}},
    {"id": "variations-main-line-first", "sgf": "(;SZ[9];B[ee](;W[dd];B[cc])(;W[cc]))", "expect": {"moves": ["ee", "dd", "cc"], "toMove": "white"}},
    {"id": "empty-variation", "sgf": "(;SZ[9];B[ee]()(;W[dd]))", "expect": {"moves": ["ee", "dd"], "toMove": "black"}},
    {"id": "first-game-of-collection", "sgf": "(;SZ[9];B[ee])(;SZ[19];B[pd];W[dd])", "expect": {"moves": ["ee"], "toMove": "white"}},
    {"id": "whitespace", "sgf": "(;SZ[9]\n  ;  B [ee]\n ; W[dd] )\n", "expect": {"moves": ["ee", "dd"], "toMove": "black"}},
    {"id": "text-before-record", "sgf": "Sent from my phone\n(;SZ[9];B[ee])", "expect": {"moves": ["ee"], "toMove": "white"}},
    {"id": "escapes-and-soft-breaks", "sgf": "(;SZ[9]C[a \\] b \\\\ c];B[ee]C[soft\\\nbreak];W[dd])", "expect": {"moves": ["ee", "dd"], "toMove": "black"}},
    {"id": "comment-only-nodes", "sgf": "(;SZ[9];C[before];B[ee];C[after];W[dd])", "expect": {"moves": ["ee", "dd"], "toMove": "black"}},
    {"id": "ff3-long-names", "sgf": "(;SZ[9]AddBlack[cc]AddWhite[gg];Black[ee];White[dd])", "expect": {"moves": ["ee", "dd"], "toMove": "black"}},
    {"id": "lowercase-name", "sgf": "(;sz[9];B[ee])", "refused": {}},
    {"id": "capture", "sgf": "(;SZ[9];B[ab];W[bb];B[ba];W[ee];B[cb];W[ff];B[bc])", "expect": {"moves": ["ab", "bb", "ba", "ee", "cb", "ff", "bc"], "toMove": "white"}},
    {"id": "handicap-stones", "sgf": "(;SZ[19]HA[2]KM[0.5]AB[dp][pd];W[dd];B[pp])", "expect": {"moves": ["dd", "pp"], "toMove": "white"}},
    {"id": "custom-setup-rectangle", "sgf": "(;SZ[9]AB[aa:bb]AW[ee];W[ff])", "expect": {"moves": ["ff"], "toMove": "black"}},
    {"id": "wrong-colour", "sgf": "(;SZ[9];B[ee];B[dd])", "refused": {"move": 2}},
    {"id": "occupied", "sgf": "(;SZ[9];B[ee];W[ee])", "refused": {"move": 2}},
    {"id": "suicide", "sgf": "(;SZ[9];B[ba];W[ff];B[ab];W[aa])", "refused": {"move": 4}},
    {"id": "ko-retake", "sgf": "(;SZ[9];B[de];W[ge];B[ed];W[fd];B[ef];W[ff];B[aa];W[ee];B[fe];W[ee])", "refused": {"move": 10}},
    {"id": "off-board", "sgf": "(;SZ[9];B[jj])", "refused": {"move": 1}},
    {"id": "both-colours-in-a-node", "sgf": "(;SZ[9];B[ee]W[dd])", "refused": {"move": 1}},
    {"id": "setup-after-root", "sgf": "(;SZ[9];B[ee];AB[aa])", "refused": {"move": 2}},
    {"id": "move-in-root", "sgf": "(;SZ[9]B[ee];W[dd])", "refused": {}},
    {"id": "truncated", "sgf": "(;SZ[9];B[ee];W[dd", "refused": {}},
    {"id": "unclosed-value", "sgf": "(;SZ[9];B[ee];C[no end", "refused": {}},
    {"id": "not-sgf", "sgf": "hello", "refused": {}},
    {"id": "resumed-after-two-passes", "sgf": "(;SZ[9];B[ee];W[];B[];W[dd])", "expect": {"moves": ["ee", "..", "..", "dd"], "toMove": "black"}, "importRefused": {"move": 4}},
    {"id": "thirteen", "sgf": "(;SZ[13];B[gg])", "expect": {"moves": ["gg"], "toMove": "white"}, "importRefused": {}}
  ]
}
